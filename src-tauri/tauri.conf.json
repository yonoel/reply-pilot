{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReplyPilot",
  "version": "0.1.0",
  "identifier": "com.yonoel.replypilot",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:3017; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"]
  }
}
